# Copia este archivo como .env.local (desarrollo) o pega cada variable en Vercel → Settings → Environment Variables.

# Cadena de conexión de Supabase → botón "Connect" → "Transaction pooler" (puerto 6543).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos (solo letras y números, sin símbolos).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API (para guardar las evidencias en el bucket privado "evidencias")
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Acceso de coordinación (usuario opcional; por defecto "coordinacion")
COORDINACION_USUARIO=coordinacion
COORDINACION_PASSWORD=cambia-esta-clave

# Secreto para firmar las sesiones (cualquier texto largo y aleatorio)
SESSION_SECRET=escribe-aqui-un-texto-largo-y-aleatorio

# Dirección pública de la app (se usa en el link de los correos de convocatoria)
NEXT_PUBLIC_APP_URL=https://protocolo-fcgt.vercel.app
